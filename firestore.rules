rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PILLAR 1: GLOBAL DEFAULT DENY-ALL CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS (AUTH, ROLES, TYPE & STRING VALIDATORS)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'thangtv1.hyn@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(val) {
      return val is string && val.size() >= 1 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || ((data[field] is int || data[field] is float) && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalList(data, field, maxLen) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxLen);
    }

    function isValidHSKLevel(level) {
      return level in ['HSK 1', 'HSK 2', 'HSK 3', 'HSK 4', 'HSK 5'];
    }

    function isValidEmail(val) {
      return val is string && val.size() >= 3 && val.size() <= 200 && val.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // =========================================================================
    // ENTITY VALIDATORS (STATELESS — NO existing() OR diff() INSIDE)
    // =========================================================================
    function isValidColorScheme(cs) {
      return cs is map &&
        cs.keys().hasAll(['bg', 'border', 'text', 'badge']) &&
        cs.keys().hasOnly(['bg', 'border', 'text', 'badge']) &&
        isValidString(cs.bg, 1, 100) &&
        isValidString(cs.border, 1, 100) &&
        isValidString(cs.text, 1, 100) &&
        isValidString(cs.badge, 1, 100);
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'level', 'title', 'vietnameseTitle', 'description', 'targetVocabCount', 'grammarPointsCount', 'colorScheme']) &&
        data.keys().hasOnly(['id', 'level', 'title', 'vietnameseTitle', 'description', 'coverImage', 'targetVocabCount', 'grammarPointsCount', 'colorScheme', 'orderIndex', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidHSKLevel(data.level) &&
        isValidString(data.title, 1, 200) &&
        isValidString(data.vietnameseTitle, 1, 250) &&
        isValidString(data.description, 0, 2000) &&
        isOptionalString(data, 'coverImage', 180000) &&
        (data.targetVocabCount is int || data.targetVocabCount is float) && data.targetVocabCount >= 0 && data.targetVocabCount <= 50000 &&
        (data.grammarPointsCount is int || data.grammarPointsCount is float) && data.grammarPointsCount >= 0 && data.grammarPointsCount <= 5000 &&
        isValidColorScheme(data.colorScheme) &&
        isOptionalNumber(data, 'orderIndex', 0, 10000) &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidLesson(data) {
      return data.keys().hasAll(['id', 'courseId', 'level', 'lessonNumber', 'title', 'vietnameseTitle', 'durationMinutes', 'description', 'vocabulary', 'grammar', 'dialogue', 'practiceQuestions']) &&
        data.keys().hasOnly(['id', 'courseId', 'level', 'lessonNumber', 'title', 'vietnameseTitle', 'durationMinutes', 'description', 'vocabulary', 'grammar', 'dialogue', 'practiceQuestions', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.courseId) &&
        isValidHSKLevel(data.level) &&
        (data.lessonNumber is int || data.lessonNumber is float) && data.lessonNumber >= 0 && data.lessonNumber <= 500 &&
        isValidString(data.title, 1, 250) &&
        isValidString(data.vietnameseTitle, 1, 250) &&
        (data.durationMinutes is int || data.durationMinutes is float) && data.durationMinutes >= 0 && data.durationMinutes <= 600 &&
        isValidString(data.description, 0, 2000) &&
        data.vocabulary is list && data.vocabulary.size() <= 200 &&
        data.grammar is list && data.grammar.size() <= 100 &&
        data.dialogue is list && data.dialogue.size() <= 200 &&
        data.practiceQuestions is list && data.practiceQuestions.size() <= 200 &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidVocabDeck(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'level', 'category', 'createdAt', 'createdBy']) &&
        data.keys().hasOnly(['id', 'title', 'vietnameseTitle', 'description', 'level', 'category', 'color', 'createdAt', 'createdBy', 'cardCount', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.title, 1, 250) &&
        isOptionalString(data, 'vietnameseTitle', 250) &&
        isValidString(data.description, 0, 2000) &&
        isValidHSKLevel(data.level) &&
        isValidString(data.category, 1, 150) &&
        isOptionalString(data, 'color', 40) &&
        isValidString(data.createdAt, 1, 64) &&
        data.createdBy in ['admin', 'ai', 'system'] &&
        isOptionalNumber(data, 'cardCount', 0, 50000) &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidVocabCard(data) {
      return data.keys().hasAll(['id', 'deckId', 'word', 'pinyin', 'meaning', 'level']) &&
        data.keys().hasOnly(['id', 'deckId', 'word', 'pinyin', 'sinoVietnamese', 'meaning', 'level', 'category', 'radical', 'strokeCount', 'exampleSentence', 'examplePinyin', 'exampleMeaning', 'imageUrl', 'orderIndex', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.deckId) &&
        isValidString(data.word, 1, 100) &&
        isValidString(data.pinyin, 1, 200) &&
        isOptionalString(data, 'sinoVietnamese', 200) &&
        isValidString(data.meaning, 1, 400) &&
        isValidHSKLevel(data.level) &&
        isOptionalString(data, 'category', 150) &&
        isOptionalString(data, 'radical', 100) &&
        isOptionalNumber(data, 'strokeCount', 0, 100) &&
        isOptionalString(data, 'exampleSentence', 600) &&
        isOptionalString(data, 'examplePinyin', 600) &&
        isOptionalString(data, 'exampleMeaning', 600) &&
        isOptionalString(data, 'imageUrl', 180000) &&
        isOptionalNumber(data, 'orderIndex', 0, 50000) &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidExam(data) {
      return data.keys().hasAll(['id', 'level', 'title', 'subtitle', 'timeLimitMinutes', 'passScore', 'totalPoints', 'questions']) &&
        data.keys().hasOnly(['id', 'level', 'title', 'subtitle', 'timeLimitMinutes', 'passScore', 'totalPoints', 'questions', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidHSKLevel(data.level) &&
        isValidString(data.title, 1, 250) &&
        isValidString(data.subtitle, 0, 300) &&
        (data.timeLimitMinutes is int || data.timeLimitMinutes is float) && data.timeLimitMinutes >= 1 && data.timeLimitMinutes <= 300 &&
        (data.passScore is int || data.passScore is float) && data.passScore >= 0 && data.passScore <= 1000 &&
        (data.totalPoints is int || data.totalPoints is float) && data.totalPoints >= 1 && data.totalPoints <= 1000 &&
        data.questions is list && data.questions.size() <= 200 &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidForumPost(data) {
      return data.keys().hasAll(['id', 'authorUid', 'authorName', 'role', 'title', 'content', 'level', 'category', 'tags', 'likes', 'repliesCount', 'createdAt', 'replies']) &&
        data.keys().hasOnly(['id', 'authorUid', 'authorName', 'authorAvatar', 'role', 'title', 'content', 'level', 'category', 'tags', 'likes', 'repliesCount', 'createdAt', 'isPinned', 'isSolved', 'replies', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidString(data.authorUid, 1, 128) &&
        isValidString(data.authorName, 1, 120) &&
        isOptionalString(data, 'authorAvatar', 150000) &&
        data.role in ['student', 'teacher', 'admin'] &&
        isValidString(data.title, 1, 250) &&
        isValidString(data.content, 1, 5000) &&
        data.level in ['HSK 1', 'HSK 2', 'HSK 3', 'HSK 4', 'HSK 5', 'Toàn bộ'] &&
        data.category in ['Ngữ pháp', 'Từ vựng', 'Kinh nghiệm thi', 'Chữa bài', 'Hỏi đáp chung'] &&
        data.tags is list && data.tags.size() <= 20 &&
        (data.likes is int || data.likes is float) && data.likes >= 0 && data.likes <= 1000000 &&
        (data.repliesCount is int || data.repliesCount is float) && data.repliesCount >= 0 && data.repliesCount <= 1000 &&
        isValidString(data.createdAt, 1, 64) &&
        isOptionalBool(data, 'isPinned') &&
        isOptionalBool(data, 'isSolved') &&
        data.replies is list && data.replies.size() <= 200 &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidUserCore(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'status', 'level', 'provider', 'joinedDate']) &&
        data.keys().hasOnly(['id', 'uid', 'name', 'email', 'avatar', 'role', 'status', 'level', 'targetLevel', 'provider', 'joinedDate', 'streakDays', 'lastActiveDate', 'xp', 'reminderTime', 'reminderEnabled', 'dailyGoalMinutes', 'masteredVocabIds', 'learningVocabIds', 'completedLessonIds', 'examHistory', 'studyLog', 'completedLessons', 'examsTaken', 'avgScore', 'note', 'updatedAt']) &&
        isValidId(data.id) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        isValidEmail(data.email) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 180000)) &&
        data.role in ['student', 'teacher', 'admin'] &&
        data.status in ['active', 'suspended'] &&
        data.provider in ['google', 'email'];
    }

    function isValidUserProfileMeta(data) {
      return isValidHSKLevel(data.level) &&
        (!('targetLevel' in data) || isValidHSKLevel(data.targetLevel)) &&
        data.joinedDate is string && data.joinedDate.size() >= 1 && data.joinedDate.size() <= 64 &&
        (!('streakDays' in data) || ((data.streakDays is int || data.streakDays is float) && data.streakDays >= 0 && data.streakDays <= 10000)) &&
        (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 64)) &&
        (!('xp' in data) || ((data.xp is int || data.xp is float) && data.xp >= 0 && data.xp <= 10000000)) &&
        (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 16)) &&
        (!('reminderEnabled' in data) || data.reminderEnabled is bool) &&
        (!('dailyGoalMinutes' in data) || ((data.dailyGoalMinutes is int || data.dailyGoalMinutes is float) && data.dailyGoalMinutes >= 1 && data.dailyGoalMinutes <= 720));
    }

    function isValidUserProgress(data) {
      return (!('masteredVocabIds' in data) || (data.masteredVocabIds is list && data.masteredVocabIds.size() <= 5000)) &&
        (!('learningVocabIds' in data) || (data.learningVocabIds is list && data.learningVocabIds.size() <= 5000)) &&
        (!('completedLessonIds' in data) || (data.completedLessonIds is list && data.completedLessonIds.size() <= 500)) &&
        (!('examHistory' in data) || (data.examHistory is list && data.examHistory.size() <= 200)) &&
        (!('studyLog' in data) || data.studyLog is map) &&
        (!('completedLessons' in data) || ((data.completedLessons is int || data.completedLessons is float) && data.completedLessons >= 0 && data.completedLessons <= 5000)) &&
        (!('examsTaken' in data) || ((data.examsTaken is int || data.examsTaken is float) && data.examsTaken >= 0 && data.examsTaken <= 5000)) &&
        (!('avgScore' in data) || ((data.avgScore is int || data.avgScore is float) && data.avgScore >= 0 && data.avgScore <= 1000)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserAccount(data) {
      return isValidUserCore(data) && isValidUserProfileMeta(data) && isValidUserProgress(data);
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidString(data.uid, 1, 128) &&
        isValidEmail(data.email) &&
        isOptionalString(data, 'grantedAt', 64);
    }

    function isValidSiteBrandAndTheme(data) {
      return data.primaryColor is string && data.primaryColor.size() >= 1 && data.primaryColor.size() <= 40 &&
        data.canvasColor is string && data.canvasColor.size() >= 1 && data.canvasColor.size() <= 40 &&
        data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 120 &&
        (!('fontScale' in data) || data.fontScale in ['13.5px', '14px', '15px']) &&
        (!('headerLogoUrl' in data) || (data.headerLogoUrl is string && data.headerLogoUrl.size() <= 180000)) &&
        (!('brandHighlight' in data) || (data.brandHighlight is string && data.brandHighlight.size() <= 120)) &&
        (!('brandSubtitle' in data) || (data.brandSubtitle is string && data.brandSubtitle.size() <= 200));
    }

    function isValidSiteHero(data) {
      return (!('heroBadge' in data) || (data.heroBadge is string && data.heroBadge.size() <= 200)) &&
        (!('heroTitleLine1' in data) || (data.heroTitleLine1 is string && data.heroTitleLine1.size() <= 200)) &&
        (!('heroTitleHighlight' in data) || (data.heroTitleHighlight is string && data.heroTitleHighlight.size() <= 200)) &&
        (!('heroTitleLine3' in data) || (data.heroTitleLine3 is string && data.heroTitleLine3.size() <= 200)) &&
        (!('heroDescription' in data) || (data.heroDescription is string && data.heroDescription.size() <= 1000)) &&
        (!('heroCtaPrimary' in data) || (data.heroCtaPrimary is string && data.heroCtaPrimary.size() <= 120)) &&
        (!('heroCtaSecondary' in data) || (data.heroCtaSecondary is string && data.heroCtaSecondary.size() <= 120)) &&
        (!('stat1Value' in data) || (data.stat1Value is string && data.stat1Value.size() <= 60)) &&
        (!('stat1Label' in data) || (data.stat1Label is string && data.stat1Label.size() <= 120)) &&
        (!('stat2Value' in data) || (data.stat2Value is string && data.stat2Value.size() <= 60)) &&
        (!('stat2Label' in data) || (data.stat2Label is string && data.stat2Label.size() <= 120)) &&
        (!('stat3Value' in data) || (data.stat3Value is string && data.stat3Value.size() <= 60)) &&
        (!('stat3Label' in data) || (data.stat3Label is string && data.stat3Label.size() <= 120));
    }

    function isValidSitePostersAndAdmission(data) {
      return (!('posterSectionBadge' in data) || (data.posterSectionBadge is string && data.posterSectionBadge.size() <= 200)) &&
        (!('posterSectionTitle' in data) || (data.posterSectionTitle is string && data.posterSectionTitle.size() <= 200)) &&
        (!('posterSectionSubtitle' in data) || (data.posterSectionSubtitle is string && data.posterSectionSubtitle.size() <= 500)) &&
        (!('poster1Url' in data) || (data.poster1Url is string && data.poster1Url.size() <= 180000)) &&
        (!('poster1Caption' in data) || (data.poster1Caption is string && data.poster1Caption.size() <= 300)) &&
        (!('poster2Url' in data) || (data.poster2Url is string && data.poster2Url.size() <= 180000)) &&
        (!('poster2Caption' in data) || (data.poster2Caption is string && data.poster2Caption.size() <= 300)) &&
        (!('admissionBadge' in data) || (data.admissionBadge is string && data.admissionBadge.size() <= 200)) &&
        (!('admissionTitle' in data) || (data.admissionTitle is string && data.admissionTitle.size() <= 250)) &&
        (!('admissionDescription' in data) || (data.admissionDescription is string && data.admissionDescription.size() <= 1000)) &&
        (!('admissionCta' in data) || (data.admissionCta is string && data.admissionCta.size() <= 120));
    }

    function isValidSiteMomentsAndFlags(data) {
      return (!('momentsSectionBadge' in data) || (data.momentsSectionBadge is string && data.momentsSectionBadge.size() <= 200)) &&
        (!('momentsSectionTitle' in data) || (data.momentsSectionTitle is string && data.momentsSectionTitle.size() <= 250)) &&
        (!('momentsSectionSubtitle' in data) || (data.momentsSectionSubtitle is string && data.momentsSectionSubtitle.size() <= 500)) &&
        (!('classroomMoments' in data) || (data.classroomMoments is list && data.classroomMoments.size() <= 30)) &&
        (!('showCoursesSection' in data) || data.showCoursesSection is bool) &&
        (!('showPostersSection' in data) || data.showPostersSection is bool) &&
        (!('showAdmissionBanner' in data) || data.showAdmissionBanner is bool) &&
        (!('showMomentsSection' in data) || data.showMomentsSection is bool);
    }

    function isValidSiteFooter(data) {
      return (!('footerLogoUrl' in data) || (data.footerLogoUrl is string && data.footerLogoUrl.size() <= 180000)) &&
        (!('footerTitle' in data) || (data.footerTitle is string && data.footerTitle.size() <= 200)) &&
        (!('footerSubtitle' in data) || (data.footerSubtitle is string && data.footerSubtitle.size() <= 300)) &&
        (!('hotline' in data) || (data.hotline is string && data.hotline.size() <= 80)) &&
        (!('footerCtaText' in data) || (data.footerCtaText is string && data.footerCtaText.size() <= 120)) &&
        (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 300)) &&
        (!('copyrightText' in data) || (data.copyrightText is string && data.copyrightText.size() <= 250)) &&
        (!('motto' in data) || (data.motto is string && data.motto.size() <= 300)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSiteUIConfig(data) {
      return data.keys().hasAll(['primaryColor', 'canvasColor', 'brandName']) &&
        data.keys().hasOnly([
          'primaryColor', 'canvasColor', 'fontScale', 'headerLogoUrl', 'brandName',
          'brandHighlight', 'brandSubtitle', 'heroBadge', 'heroTitleLine1',
          'heroTitleHighlight', 'heroTitleLine3', 'heroDescription', 'heroCtaPrimary',
          'heroCtaSecondary', 'stat1Value', 'stat1Label', 'stat2Value', 'stat2Label',
          'stat3Value', 'stat3Label', 'posterSectionBadge', 'posterSectionTitle',
          'posterSectionSubtitle', 'poster1Url', 'poster1Caption', 'poster2Url',
          'poster2Caption', 'admissionBadge', 'admissionTitle', 'admissionDescription',
          'admissionCta', 'momentsSectionBadge', 'momentsSectionTitle',
          'momentsSectionSubtitle', 'classroomMoments', 'showCoursesSection',
          'showPostersSection', 'showAdmissionBanner', 'showMomentsSection',
          'footerLogoUrl', 'footerTitle', 'footerSubtitle', 'hotline',
          'footerCtaText', 'facebook', 'copyrightText', 'motto', 'updatedAt'
        ]) &&
        isValidSiteBrandAndTheme(data) &&
        isValidSiteHero(data) &&
        isValidSitePostersAndAdmission(data) &&
        isValidSiteMomentsAndFlags(data) &&
        isValidSiteFooter(data);
    }

    // =========================================================================
    // CONNECTION PROBE (HEALTH CHECK)
    // =========================================================================
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // =========================================================================
    // COURSES & LESSONS (PUBLIC CATALOG — ADMIN WRITE)
    // =========================================================================
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidCourse(incoming()) && incoming().id == courseId;
      allow update: if isAdmin() && isValidCourse(incoming()) && incoming().id == existing().id && incoming().id == courseId;
      allow delete: if isAdmin();

      match /lessons/{lessonId} {
        allow get, list: if true;
        allow create: if isAdmin() && isValidLesson(incoming()) && incoming().id == lessonId && incoming().courseId == courseId;
        allow update: if isAdmin() && isValidLesson(incoming()) && incoming().id == existing().id && incoming().id == lessonId && incoming().courseId == courseId;
        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    // VOCABULARY DECKS & CARDS (SCALABLE TO 3,000+ CARDS — ADMIN WRITE)
    // =========================================================================
    match /vocabDecks/{deckId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidVocabDeck(incoming()) && incoming().id == deckId;
      allow update: if isAdmin() && isValidVocabDeck(incoming()) && incoming().id == existing().id && incoming().id == deckId;
      allow delete: if isAdmin();

      match /cards/{cardId} {
        allow get, list: if true;
        allow create: if isAdmin() && isValidVocabCard(incoming()) && incoming().id == cardId && incoming().deckId == deckId;
        allow update: if isAdmin() && isValidVocabCard(incoming()) && incoming().id == existing().id && incoming().id == cardId && incoming().deckId == deckId;
        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    // EXAMS (PUBLIC CATALOG — ADMIN WRITE)
    // =========================================================================
    match /exams/{examId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidExam(incoming()) && incoming().id == examId;
      allow update: if isAdmin() && isValidExam(incoming()) && incoming().id == existing().id && incoming().id == examId;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // FORUM POSTS (COMMUNITY Q&A — NO PII)
    // =========================================================================
    match /forumPosts/{postId} {
      allow get, list: if true;
      allow create: if isValidForumPost(incoming()) &&
        incoming().id == postId &&
        (
          isAdmin() ||
          (isSignedIn() && incoming().authorUid == request.auth.uid && incoming().role == 'student' && (!('isPinned' in incoming()) || incoming().isPinned == false))
        );
      allow update: if isValidForumPost(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        (
          isAdmin() ||
          (
            isSignedIn() &&
            existing().authorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'tags', 'level', 'category', 'isSolved', 'replies', 'repliesCount', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'updatedAt']) &&
            incoming().likes == existing().likes + 1
          ) ||
          (
            isSignedIn() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['replies', 'repliesCount', 'updatedAt']) &&
            incoming().replies.size() == existing().replies.size() + 1 &&
            incoming().repliesCount == existing().repliesCount + 1
          )
        );
      allow delete: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
    }

    // =========================================================================
    // USERS (STRICT PII ISOLATION — OWNER OR ADMIN ONLY)
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidUserAccount(incoming()) &&
        incoming().id == userId &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            isVerifiedUser() &&
            incoming().role == 'student' &&
            incoming().status == 'active' &&
            incoming().email == request.auth.token.email
          )
        );
      allow update: if isValidUserAccount(incoming()) &&
        incoming().id == existing().id &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            incoming().provider == existing().provider &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'name', 'avatar', 'level', 'targetLevel',
              'streakDays', 'lastActiveDate', 'xp', 'reminderTime',
              'reminderEnabled', 'dailyGoalMinutes', 'masteredVocabIds',
              'learningVocabIds', 'completedLessonIds', 'examHistory',
              'studyLog', 'completedLessons', 'examsTaken', 'avgScore',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // ADMIN ROLE MARKERS (BOOTSTRAPPED ADMIN ONLY)
    // =========================================================================
    match /admins/{uid} {
      allow get: if isOwner(uid) || isBootstrappedAdmin();
      allow list: if isBootstrappedAdmin();
      allow create, update: if isBootstrappedAdmin() && isValidAdminMarker(incoming()) && incoming().uid == uid;
      allow delete: if isBootstrappedAdmin() && uid != request.auth.uid;
    }

    // =========================================================================
    // SITE UI CONFIGURATION (PUBLIC READ — ADMIN WRITE)
    // =========================================================================
    match /siteConfig/{configId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidSiteUIConfig(incoming());
      allow delete: if isAdmin();
    }
  }
}
